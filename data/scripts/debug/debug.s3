extends Canvas

var fullscreen: bool = false
var _fullscreen_cooldown: float = 0.0
var _framerate_label: Label

func iStart() -> void:
	set_update(true)
	_framerate_label = Label.new()
	_framerate_label.name = "framerate_label"
	_framerate_label.position = Vector2(5.0, 5.0)
	_framerate_label.add_theme_color_override("font_color", Color.BLACK)
	add_child(_framerate_label)

func Update(delta: float) -> void:
	_fullscreen_cooldown = maxf(0.0, _fullscreen_cooldown - delta)
	_toggle_fullscreen()
	_framerate_label.text = "FPS: %d" % Engine.get_frames_per_second()
	if Input.is_action_just_pressed("KEY_F6"):
		get_tree().reload_current_scene()

func _toggle_fullscreen() -> void:
	if _fullscreen_cooldown > 0.0:
		return
	if Input.is_action_pressed("KEY_ALT") and Input.is_action_just_pressed("KEY_ENTER"):
		fullscreen = not fullscreen
		get_window().mode = Window.MODE_EXCLUSIVE_FULLSCREEN if fullscreen else Window.MODE_WINDOWED
		_fullscreen_cooldown = 0.2
